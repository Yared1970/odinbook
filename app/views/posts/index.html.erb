
<h1>Odinbook Feed</h1>

<%= link_to "Create New Post", new_post_path %>

<% if @posts.any? %>
  <% @posts.each do |post| %>
    <article>
      <p>
        <%= link_to post.user.username,
                    user_path(post.user) %>
      </p>

      <p><%= post.content %></p>

      <%= link_to "View Post", post_path(post) %>
    </article>
    <hr>
  <% end %>
<% else %>
  <p>
    Your feed is empty. Follow other users to see
    their posts here.
  </p>
<% end %>
