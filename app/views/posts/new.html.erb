
<h1>Create a New Post</h1>

<%= form_with model: @post do |form| %>
  <% if @post.errors.any? %>
    <ul>
      <% @post.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  <% end %>

  <div>
    <%= form.label :content %>
    <%= form.text_area :content, rows: 4 %>
  </div>

  <div>
    <%= form.submit "Publish Post" %>
  </div>
<% end %>

<%= link_to "Back to Feed", posts_path %>
